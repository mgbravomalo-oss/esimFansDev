  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "test:db": "node scripts/test-db.js",
    "export:d1": "node scripts/export-mongo-to-d1.js",
    "seed:d1": "node scripts/seed-d1.js",
    "sync:d1": "node scripts/sync-esimaccess-to-d1.js",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "expo-constants": "~57.0.20",
    "expo-device": "^57.0.2",
    "expo-haptics": "^57.0.3",
    "expo-linking": "~57.0.11",
    "expo-router": "~57.0.24",
    "expo-status-bar": "~57.0.1",
    "express": "^4.21.2",
    "firebase-admin": "^14.4.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "lucide-react-native": "^1.50.0",
    "mongodb": "^7.6.0",
    "mongoose": "^9.9.4",
    "motion": "^12.23.24",
    "node-cron": "^4.6.0",
    "nodemailer": "^10.0.7",
    "qrcode": "^1.5.4",
